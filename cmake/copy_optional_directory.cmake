if(NOT DEFINED SOURCE_DIR)
    message(FATAL_ERROR "SOURCE_DIR was not provided")
endif()

if(NOT DEFINED DEST_DIR)
    message(FATAL_ERROR "DEST_DIR was not provided")
endif()

file(TO_CMAKE_PATH "${SOURCE_DIR}" SOURCE_DIR_NORMALIZED)
file(TO_CMAKE_PATH "${DEST_DIR}" DEST_DIR_NORMALIZED)

if(EXISTS "${SOURCE_DIR_NORMALIZED}")
    if(DEFINED CLEAN_DESTINATION AND CLEAN_DESTINATION AND EXISTS "${DEST_DIR_NORMALIZED}")
        file(REMOVE_RECURSE "${DEST_DIR_NORMALIZED}")
    endif()
    file(MAKE_DIRECTORY "${DEST_DIR_NORMALIZED}")
    file(COPY "${SOURCE_DIR_NORMALIZED}/" DESTINATION "${DEST_DIR_NORMALIZED}")
    message(STATUS "Copied optional directory: ${SOURCE_DIR_NORMALIZED} -> ${DEST_DIR_NORMALIZED}")
else()
    if(DEFINED CLEAN_DESTINATION AND CLEAN_DESTINATION AND EXISTS "${DEST_DIR_NORMALIZED}")
        file(REMOVE_RECURSE "${DEST_DIR_NORMALIZED}")
        message(STATUS "Removed stale optional directory: ${DEST_DIR_NORMALIZED}")
    endif()
    message(STATUS "Optional directory not found, skipping copy: ${SOURCE_DIR_NORMALIZED}")
endif()
